# OpenVINS (rpng) ov_msckf on ROS1 Noetic. Same dependencies as open_vins/Dockerfile_ros1_20_04,
# minus its CLion/sshd dev setup, with the workspace built into the image.
# Build: see build_images.sh (source comes from the named context "src" = ~/vio_tools/open_vins).
# BASE: osrf/ros:noetic-desktop-full on x86 laptops (has RViz); ros:noetic-perception on the Pi 5 (arm64,
# osrf's desktop-full image is amd64 only). The ROS packages below make either base enough for OpenVINS
# and for live/live_node.py.
ARG BASE=osrf/ros:noetic-desktop-full
FROM ${BASE}

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      git nano python3-catkin-tools python3-osrf-pycommon \
      cmake libeigen3-dev libgoogle-glog-dev libgflags-dev libatlas-base-dev libsuitesparse-dev libceres-dev \
      python3-dev python3-matplotlib python3-numpy python3-psutil python3-tk \
      ros-noetic-tf ros-noetic-cv-bridge ros-noetic-image-transport ros-noetic-nav-msgs \
      ros-noetic-visualization-msgs ros-noetic-rosbag python3-opencv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /catkin_ws
RUN mkdir -p src && catkin init && catkin config --extend /opt/ros/noetic \
    && catkin config --cmake-args -DCMAKE_BUILD_TYPE=Release
COPY --from=src . src/open_vins
ARG JOBS=4
RUN catkin build -j${JOBS} --no-status && rm -rf build logs

COPY entrypoint.sh /entrypoint.sh
WORKDIR /data
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
