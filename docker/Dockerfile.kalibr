# Kalibr (ethz-asl) on ROS1 Noetic. Based on kalibr/Dockerfile_ros1_20_04, with capped build jobs
# (WSL has ~7 GB RAM) and an entrypoint that sources the workspace so `rosrun kalibr ...` works directly.
# Build: see build_images.sh (source comes from the named context "src" = ~/vio_tools/kalibr).
FROM osrf/ros:noetic-desktop-full

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      git wget autoconf automake nano \
      python3-dev python3-pip python3-scipy python3-matplotlib \
      ipython3 python3-wxgtk4.0 python3-tk python3-igraph python3-pyx \
      libeigen3-dev libboost-all-dev libsuitesparse-dev doxygen libopencv-dev \
      libpoco-dev libtbb-dev libblas-dev liblapack-dev libv4l-dev \
      python3-catkin-tools python3-osrf-pycommon \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /catkin_ws
RUN mkdir -p src && catkin init && catkin config --extend /opt/ros/noetic \
    && catkin config --cmake-args -DCMAKE_BUILD_TYPE=Release
COPY --from=src . src/kalibr
ARG JOBS=4
RUN catkin build -j${JOBS} --no-status && rm -rf build logs

# Fall back to a manual focal-length guess if Kalibr cannot initialise it (ethz-asl/kalibr#346)
ENV KALIBR_MANUAL_FOCAL_LENGTH_INIT=1
COPY entrypoint.sh /entrypoint.sh
WORKDIR /data
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
