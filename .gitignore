# Raw recordings and converted datasets are large; keep them out of git
recordings/
data/*
# validation reports, studies and videos are small enough to keep (live/validate.sh, offline/*study*)
!data/validate_*/
!data/videos/
!data/scale_study.*
!data/error_decomposition.*
*.bag

# Python
.venv/
__pycache__/
*.pyc

# Build logs and generated OpenVINS configs (regenerate with calib/kalibr_to_openvins.py)
docker/build.log
calib/openvins/*/
!calib/openvins/crazyflie/
!calib/openvins/pi5/

# session scratch
tmp/
.claude/
